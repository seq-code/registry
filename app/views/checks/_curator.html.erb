<%
  no_message ||= false
  no_section ||= false
  warn_class =
    if !warn.check
      'check-skip'
    elsif warn.check.pass
      'check-pass'
    else
      'check-fail'
    end
%>
<dt class="<%= warn_class %>">
  <span class="check-links">
    <%= icon_link_to(
          'minus-circle', 'Skip', '#',
          data: { do: 'skip', kind: warn.type, name: warn.name.id }
        ) %>
    <%= icon_link_to(
          'check-circle', 'Pass', '#',
          data: { do: 'pass', kind: warn.type, name: warn.name.id }
        ) %>
    <%= icon_link_to(
          'exclamation-circle', 'Fail', '#',
          data: { do: 'fail', kind: warn.type, name: warn.name.id }
        ) %>
  </span>
  <span><%= warn.title %></span>
</dt>
<dd class="pb-2">
  <% if warn[:rules] || warn[:recommendations] || warn[:rule_notes] %>
    <%= warn[:message] unless no_message %>
    <% unless no_section %>
      <div class="text-muted">
        <b>§ SeqCode</b>:
          <% %w[rule rule_note recommendation].each do |section| %>
            <% warn[:"#{section}s"]&.each do |i| %>
              •
              <% text = name_of_seqcode_section(section, i) %>
              <%= link_to_seqcode_excerpt(section, i, text) %>
            <% end %>
          <% end %>
      </div>
    <% end %>
  <% end %>
</dd>
