<% publication.publication_names.each do |publication_name| %>
  <% name = publication_name.name %>
  <%= link_to(
        name.abbr_name, name, class: 'badge badge-pill badge-primary') %>
  <% if current_contributor? %>
    <%= icon_link_to(
          'trash-alt', "Unlink #{name.abbr_name}", publication_name,
          method: :delete, class: 'badge badge-pill badge-info',
          data: { confirm: 'Are you sure?' }
        ) %>
  <% end %>
<% end %>
<% if current_contributor? %>
  <%= icon_link_to(
        'link', 'Link names', link_publication_name_path(publication),
        class: 'badge badge-pill badge-info'
      ) %>
<% end %>
