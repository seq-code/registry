<% unless @name.present? %>
  <div class="alert alert-warning">
    <h4>Marked for deletion</h4>
    This strain is currently not registered as the nomenclatural type or the
    reference strain of any names in the Registry. Unless it is linked to a
    name, it will be removed from the database after
    <strong><%= l(@strain.orphan_removal_date, format: :long) %></strong>
    (<%= Strain::ORPHAN_RETENTION.inspect %> after its last update)
  </div>
<% end %>

<% if @strain.typified_names.count > 1 %>
  <div class="alert alert-info">
    This strain is associated as type material for multiple names:
    <ul>
      <% @strain.typified_names.each do |name| %>
        <li><%= link_to(name) { %><%= name.name_html %><% } %></li>
      <% end %>
    </ul>
  </div>
<% end %>
