<% provide(:title, "History of #{@name.abbr_name_raw}") %>

<h1>History of <%= @name.name_html %></h1>
<p><%= link_to('Back to name', @name) %></p>

<% if @versions.empty? %>
  <p class="text-muted">No history has been recorded for this name.</p>
<% else %>
  <div class="name-history-list">
    <% @versions.each do |version| %>
      <div class="name-history-version" data-version-id="<%= version.id %>">
        <time class="name-history-date" datetime="<%= version.created_at.iso8601 %>">
          <%= version.created_at.strftime('%F %H:%M %Z') %>
        </time>

        <div class="name-history-event">
          <%= render "names/history/#{version.record_type.underscore}",
                     version: version, history: @history %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

<%= will_paginate(@versions) %>
