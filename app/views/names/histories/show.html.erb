<% provide(:title, "History of #{@name.abbr_name_raw}") %>

<h1>History of <%= @name.name_html %></h1>
<p><%= link_to('Back to name', @name) %></p>

<% if @versions.empty? %>
  <p class="text-muted">No history has been recorded for this name.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-sm name-history-table">
      <thead>
        <tr>
          <th scope="col">Date</th>
          <th scope="col">By</th>
          <th scope="col">Attribute</th>
          <th scope="col">Before</th>
          <th scope="col">After</th>
        </tr>
      </thead>
      <% @versions.each do |version| %>
        <% rows = history_rows(version, @history.changes_for(version)) %>
        <tbody class="name-history-version" data-version-id="<%= version.id %>">
          <% rows.each_with_index do |(label, before, after), index| %>
            <tr class="<%= before ? 'name-history-change' : 'name-history-record' %>">
              <% if index.zero? %>
                <th class="name-history-date" scope="rowgroup" rowspan="<%= rows.size %>">
                  <time datetime="<%= version.created_at.iso8601 %>">
                    <%= version.created_at.strftime('%F %H:%M %Z') %>
                  </time>
                </th>
                <td class="name-history-author" rowspan="<%= rows.size %>">
                  <%= render('names/histories/author', version: version) %>
                </td>
              <% end %>
              <% if before %>
                <th scope="row"><%= label %></th>
                <td class="name-history-before"><%= before %></td>
                <td class="name-history-after"><%= after %></td>
              <% else %>
                <th colspan="3"><%= label %></th>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>
<% end %>

<%= will_paginate(@versions) %>
