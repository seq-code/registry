<%= download_buttons(
      [[community_members_active_url(format: :csv), 'file-csv', 'CSV']]
    ) %>

<h1>
  Active community members
  <div class="badge badge-count"><%= @members.total_entries %></div>
</h1>
<div class="container p-0">
  <div class="row">
    <div class="col-sm-12 text-right">
      <%= list_type_selector %>
    </div>
  </div>
</div>
<hr/>

<%= adaptable_list(set: @members) do |list| %>
  <% @members.each do |member| %>
    <%= adaptable_entry(list, member.full_name, "mailto:#{member.email}") do |entry| %>
      <%= adaptable_value(entry, 'Email') { member.email } %>
      <%= adaptable_value(entry, 'Affiliation') { member.affiliation } %>
      <%= adaptable_value(entry, 'Department') { member.department } %>
      <%= adaptable_value(entry, 'Position') { member.position } %>
    <% end %>
  <% end %>
<% end %>
