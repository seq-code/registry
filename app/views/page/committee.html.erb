<%#
  The committee for each term is defined in config/committee/<start year>.yml,
  the people in config/committee/people.yml, and the description of each body
  in app/views/page/committee/_<body>.html.erb
%>
<% provide(
     :title,
     params[:term] ? "SeqCode Committee #{@term.label}" : 'SeqCode Committee'
   ) %>

<% if @term.past? %>
  <div class="alert alert-secondary">
    This page preserves the record of the SeqCode Committee for the
    <%= @term.label %> term.
    <% if @current_term && @current_term != @term %>
      See the <%= link_to('current SeqCode Committee', page_committee_path) %>.
    <% end %>
  </div>
<% elsif @term.upcoming? %>
  <div class="alert alert-info">
    This is the SeqCode Committee for the <%= @term.label %> term, which has
    not started yet. Its composition may change before the term starts.
  </div>
<% end %>

<div class="px-md-3 mx-md-3 px-lg-5 mx-lg-5 mb-3">
  <%= inline_svg_tag('organigram.svg') %>
</div>
<hr/>

<% people = @term.people %>
<% people.each do |id, person| %>
  <% modal('SeqCode Committee', id: "modal-person-#{id}", size: :lg) do %>
    <h3><%= person[:name] %></h3>
    <h5><%= person[:affiliation] %></h5>
    <p><%= sanitize(person[:bio]) %></p>
    <% if person[:url].present? %>
      <hr/>
      <%= link_to(person[:url], target: :_blank) do %>
        <%= person[:url] %>
        <%= fa_icon('external-link-alt') %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<dl class="border-secondary pl-3 my-4" style="border-left: 0.5em solid;">
  <%= render(partial: 'page/committee/community', locals: { term: @term }) %>
</dl>

<% @term.bodies.each do |body, roles| %>
  <dl class="border-secondary pl-3 my-4" style="border-left: 0.5em solid;">
    <%= render(partial: "page/committee/#{body}") %>
    <% roles.each do |role| %>
      <dt><%= sanitize(role[:role]) %></dt>
      <dd>
        <% if role[:people].empty? %>
          <span class="text-muted">To be announced</span>
        <% end %>
        <% role[:people].each_with_index do |id, k| %>
          <%= tag.br if k > 0 %>
          <%= modal_button(
                "modal-person-#{id}", class: 'text-primary'
              ) do %>
            <%= fa_icon('caret-right', class: 'ml-2') %>
            <b><%= people[id.to_sym][:name] %></b>,
            <%= people[id.to_sym][:affiliation] %>
          <% end %>
        <% end %>
      </dd>
    <% end %>
  </dl>
<% end %>

<br/><br/>
