<%= simple_form_for(@tag) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification(message: f.object.errors[:base].to_sentence) if
         f.object.errors[:base].present? %>

  <div class="form-inputs">
    <%= f.input(:name) %>
    <%= f.input(
          :slug,
          hint: 'Short stable identifier used programmatically: lowercase ' \
                'letters, digits, and hyphens only (suggested from the name)'
        ) %>
    <b>Color</b><br/>
    <%= f.color_field(:color) %>
    <br/>
    <br/>
    <%= f.input(
          :parent_id,
          label: 'Umbrella tag',
          collection: Tag.top_level.where.not(id: @tag.id).order(:name),
          include_blank: '(none: top-level or standalone tag)',
          hint: 'Only top-level tags can be used as umbrellas'
        ) %>
    <%= f.input(:description, as: :rich_text_area) %>
    <%= f.input(
          :prompt_notes, as: :text,
          label: 'Prompt notes (internal, not shown in UI)'
        ) %>
    <%= f.input(
          :excluded_bases, as: :text,
          label: 'Excluded bases (one per line; proposals of this tag ' \
                 'based only on one of these terms are dropped)'
        ) %>
    <%= f.input(
          :explicit_basis_pattern,
          label: 'Explicit basis pattern (regex; proposals of this tag ' \
                 'whose basis does not match are capped at medium ' \
                 'confidence)'
        ) %>
    <%= f.input(
          :implied_tag_ids,
          label: 'Implies',
          collection: Tag.where.not(id: @tag.id).order(:name),
          input_html: { multiple: true },
          hint: 'Tags added automatically whenever this tag is proposed ' \
                '(the umbrella tag is always added)'
        ) %>
  </div>

  <div class="form-actions">
    <%= f.button(:submit) %>
    <%= link_to(
          'Cancel', @tag.persisted? ? tag_path(@tag) : tags_path,
          class: 'btn btn-secondary'
        ) %>
  </div>
<% end %>

<script>
  (function() {
    var slug = $('#tag_slug');
    var touched = slug.val() !== '';
    slug.on('input', function() { touched = true; });
    $('#tag_name').on('input', function() {
      if (touched) return;
      slug.val(
        $(this).val().toLowerCase()
          .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
      );
    });
  })();
</script>
