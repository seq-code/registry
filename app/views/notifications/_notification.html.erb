<%= adaptable_entry(
      list, '', notifiable, full_link: true
    ) do |entry| %>
  <%= adaptable_value(entry, 'Notification') do %>
    <%= fa_icon('caret-right', class: 'mr-3') %>
    <%= display_link(notifiable) %>
    <div class="container alerts">
      <% notifiable.notifications(current_user).each_with_index do |alert, k| %>
        <% if k >= 2 %>
          <div class="row"><%= fa_icon('ellipsis-h', class: 'ml-4 p-1') %></div>
          <% break %>
        <% end %>
        <div class="row clickeable <%= 'unseen-alert' unless alert.seen? %>"
             data-href="<%= polymorphic_url(alert)%>"
             onclick="location.href=$(this).data('href');">
          <div class="col-8">
            <%= icon_link_to(
                  'circle', "Mark as #{'un' unless alert.seen?}seen",
                  toggle_seen_notification_url(alert),
                  method: :post, class: 'btn btn-sm',
                  icon_options: {
                    class: 'text-info', type: alert.seen? ? :regular : :solid
                  }
                ) %>
            <%= alert.title || alert.action %>
          </div>
          <div class="col-4 text-right">
            <%= time_ago_with_date(alert.created_at) %>
            <%= icon_link_to(
                  'trash', 'Delete notification', alert,
                  method: :delete, class: 'btn btn-sm',
                  icon_options: { class: 'text-danger' }
                ) %>
            <%= icon_link_to(
                  'arrow-circle-right', 'See notification', alert,
                  class: 'btn btn-sm', icon_options: { class: 'text-primary' }
                ) %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
